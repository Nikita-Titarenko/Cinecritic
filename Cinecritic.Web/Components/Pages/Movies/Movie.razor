@page "/user/movie/{MovieId}-{MovieTitle}"
@rendermode InteractiveServer
@implements IDisposable
@inherits BasePage

<PageTitle>@MovieTitle</PageTitle>
<div class="row">
	<div class="col-4">
		<div class="d-flex mx-auto">
			<img class="rounded-3 w-100" src="@MovieVm.ImagePath" alt="Movie poster"/>
		</div>
		<div class="row pt-4">
			<div class="col d-flex justify-content-center gap-2">
				<i class="fa fa-eye fs-3 watched-color">
				</i>
				<p class=" watched-color">@MovieVm.TotalWatches</p>
			</div>
			<div class="col d-flex justify-content-center gap-2">
				<i class="fa fa-heart fs-3 liked-color"></i>
				<p class="liked-color">@MovieVm.LikedCount</p>
			</div>
			<div class="col d-flex justify-content-center gap-2">
				<i class="fa fa-clock fs-3 in-watch-list-color"></i>
				<p class="in-watch-list-color">@MovieVm.WatchListCount</p>
			</div>
		</div>
		<div class="d-flex justify-content-around align-items-center pt-4">
			<p class="fw-bold fs-3">Ratings</p>
			<div class="d-flex flex-column align-items-center gap-2 bg-container rounded-3 p-2">
				<p class="fw-bold fs-3 color-gold">@Math.Round(MovieVm.AverageRating, 1)</p>
				<div class="d-flex">
					@for (int i = 1; i <= 5; i++)
					{
						var index = i;
						<i style="width: @(StarSize)px"
						   class="fa fs-2 @GetAverageRateButtonClass(index - 1)">
						</i>
					}
				</div>
			</div>
		</div>
	</div>
	<div class="col-4">
		<div class="d-flex flex-wrap align-items-end w-100">
			<h2 class="me-3  my-auto">@MovieTitle</h2>
			<h4 class=" my-auto">@MovieVm.ReleaseDate</h4>
			<span class="badge bg-secondary my-auto">@MovieVm.MovieType.Name</span>
		</div>
		<p class="text-start">@MovieVm.Description</p>
	</div>
	<AuthorizeView>
		<Authorized>
			<div class="bg-container rounded-3 mb-auto col-3">
				<div class="row pt-2">
					<div class="col d-flex flex-column align-items-center pointer" @onclick="ToggleWatchAsync">
						<i class="fa fa-eye fs-2 @IsWatchedClass">
						</i>
						<p class="@IsWatchedClass">Watch</p>
					</div>
					<div class="col d-flex flex-column align-items-center pointer" @onclick="ToggleLikeAsync">
						<i class="fa fa-heart fs-2 @IsLikedClass"></i>
						<p class="@IsLikedClass">Like</p>
					</div>
					<div class="col d-flex flex-column align-items-center pointer" @onclick="ToggleInWatchListAsync">
						<i class="fa fa-clock fs-2 @IsInWatchedListClass"></i>
						<p class="@IsInWatchedListClass">WatchList</p>
					</div>
				</div>
				<hr />
				<div class="d-flex justify-content-center gap-2">
					<p>Rate</p>
					<div>
						@for (int i = 1; i <= 5; i++)
						{
							int index = i;

							<i @onmouseenter="e => EnterOnStars(index, e.OffsetX)"
							   @onmouseleave="LeaveFromStars"
							   @onmousemove="e => MoveInStars(index, e.OffsetX)"
							   @onclick="e => ClickOnStarAsync(index, e.OffsetX)"
							   style="@($"width:{StarSize}px")"
							   class="fa fs-2 pointer @GetYourRateButtonClass(index - 1)">
							</i>
						}
					</div>
				</div>
				<hr />
					<div class="d-flex gap-2 mb-3">
						<NavLink href="@($"/manager/editmovie/{MovieId}")" class="btn btn-warning">
							<i class="fa fa-edit"></i> Edit
						</NavLink>
						<button class="btn btn-danger" @onclick="ConfirmDelete">
							<i class="fa fa-trash"></i> Delete
						</button>
					</div>
			</div>
		</Authorized>
		<NotAuthorized>
			<div class="bg-container rounded-3 mb-auto col-3 px-3 py-4 d-flex justify-content-center">
				<NavLink href="/Account/Login" class="btn btn-success">Sign in to rate</NavLink>
			</div>
		</NotAuthorized>
	</AuthorizeView>
</div>
@if (MovieVm.FilmingLocations != null && MovieVm.FilmingLocations.Any())
{
	<div class="row mt-5">
		<div class="col-6 mx-auto">
			<h3 class="mb-4 text-start">Filming Locations <i class="fa fa-map-location-dot color-gold"></i></h3>
			<div class="list-group">
				@foreach (var location in MovieVm.FilmingLocations)
				{
					<div class="bg-container rounded-3 p-3 mb-3 border-0 shadow-sm">
						<div class="d-flex justify-content-between align-items-start">
							<div class="text-start">
								<h5 class="fw-bold mb-1 color-gold">@location.PlaceName</h5>
								<p class="mb-2 text-white-50">@location.Description</p>
							</div>
							<a href="@($"https://www.google.com/maps/search/?api=1&query={location.Location.Coordinates[1].ToString(System.Globalization.CultureInfo.InvariantCulture)},{location.Location.Coordinates[0].ToString(System.Globalization.CultureInfo.InvariantCulture)}")" 
							   target="_blank" 
							   class="btn btn-outline-primary btn-sm rounded-pill">
								<i class="fa fa-location-arrow"></i> View on Map
							</a>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

<div class="row mt-5">
	<div class="col-6 mx-auto">
		<AuthorizeView>
		</AuthorizeView>
	</div>
</div>
<div class="row mt-5">
	<div class="col-6 mx-auto">
		<AuthorizeView>
			<Authorized>
				@if (_userId != null)
				{
					<div class="card bg-container text-end">
						<div class="card-body">
							<EditForm Model="MovieVm.CurrentUserInteraction" OnValidSubmit="HandleValidSubmit" Context="editContext">
								<DataAnnotationsValidator />
								<ValidationSummary />
								<InputTextArea @bind-Value="ReviewText" class="w-100 bg-textarea-review color-text p-3" placeholder="Write a review..." />
								<button class="btn btn-primary" type="submit">
									@(string.IsNullOrEmpty(MovieVm.CurrentUserInteraction.ReviewText) ? "Create" : "Edit")
								</button>
							</EditForm>
						</div>
					</div>
				}
				else
				{
					<p>Loading user data...</p>
				}
			</Authorized>
			<NotAuthorized>
				<div class="bg-container rounded-3 mb-3 col-6 p-4 d-flex justify-content-center mx-auto">
					<NavLink href="/Account/Login" class="btn btn-success">Sign in to review</NavLink>
				</div>
			</NotAuthorized>
		</AuthorizeView>
		@foreach (var review in MovieVm.Reviews)
		{
			<div class="card bg-container my-3">
				<div class="card-body">
					<div class="d-flex justify-content-between">
						<div class="d-flex mb-3 gap-2 align-items-center">
							<i class="fa fa-circle-user card-img fs-2"></i>
							<h5 class="card-title">
								@review.Name
							</h5>
							@if (review.Rate != null)
							{
								<div class="d-flex">
									@for (int i = 1; i <= 5; i++)
									{
										var index = i;
										<i class="fa fs-5 @GetUserRateButtonClass(index - 1, review.Rate.Value)">
										</i>
									}
								</div>
							}
							@if (review.IsLiked)
							{
								<i class="fa fa-heart fs-5 liked-color fs-5">
								</i>
							}
						</div>
						<p>@review.ReviewDateTime</p>
					</div>
					<div class="w-100 bg-textarea-review text-white p-3">
						<p class="text-start">@review.ReviewText</p>
					</div>
				</div>
			</div>
		}
	</div>
</div>